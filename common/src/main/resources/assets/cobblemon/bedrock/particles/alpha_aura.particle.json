{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:alpha_aura",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particles/alpha_aura"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 3,
        "max_particles": 20
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 2
      },
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0, 0],
        "radius": "math.clamp(q.entity_size,1,2)",
        "surface_only": true,
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_initial_speed": "math.random(1, 4)",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.15 + variable.particle_age * 0.3", "0.15 + variable.particle_age * 0.3"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#ffb833ff",
            "0.5": "#ffc95fff",
            "1.0": "#ffffffff"
          }
        }
      }
    }
  }
}